{
  "name": "tapestry",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently -n client,server -c magenta,cyan \"pnpm --filter @tapestry/client dev\" \"pnpm --filter @tapestry/server dev\"",
    "build": "pnpm --filter @tapestry/shared build && pnpm --filter @tapestry/client build && pnpm --filter @tapestry/server build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
